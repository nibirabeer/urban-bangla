rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Users ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Users can update their own profile but CANNOT change role or admin status
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin']);

      // Only admins can create, fully update, or delete user documents
      allow create, delete: if isAdmin();
      allow update: if isAdmin();

      // ── Orders subcollection ──────────────────────────────────────
      match /orders/{orderId} {
        allow read: if isOwner(userId) || isAdmin();

        // Users can only create orders for themselves with valid status & price
        allow create: if isOwner(userId) &&
          request.resource.data.status == 'Processing' &&
          request.resource.data.totalPrice is number &&
          request.resource.data.totalPrice > 0;

        // Only admins can update or delete orders
        allow update, delete: if isAdmin();
      }
    }

    // ── Products — public read, admin write only ───────────────────
    match /clothing/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Store config — authenticated read, admin write ─────────────
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Deny everything else ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
