rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuth() && (u.role == 'admin' || u.admin == true);
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Users ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their OWN profile on signup (role must be "user", no admin flag)
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user' &&
        !request.resource.data.keys().hasAny(['admin']);

      // Users can update their own profile but CANNOT change role or admin status
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin']);

      // Admins can do everything
      allow create, update, delete: if isAdmin();

      // ── Orders subcollection ────────────────────────────────────
      match /orders/{orderId} {
        allow read: if isOwner(userId) || isAdmin();

        // Users can only create their own orders with valid status & price
        allow create: if isOwner(userId) &&
          request.resource.data.status == 'Processing' &&
          request.resource.data.totalPrice is number &&
          request.resource.data.totalPrice > 0;

        // Only admins can update or delete orders
        allow update, delete: if isAdmin();
      }
    }

    // ── Products — public read, admin write only ───────────────────
    match /clothing/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Store config — public read (announcement bars, promos shown to guests)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Deny everything else ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
